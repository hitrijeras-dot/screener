//@version=6
// Sweep Screener · Claude — riše isto kot graf v aplikaciji Sweep (zaslon Screener) + današnje Sweep 1D limite.
// Logika = /*SM*/ smBull v sweep/index.html (replikacija OnlyWicks Sweep Model, umerjena 14. 10. 2026 po opisu in risbah pravega indikatorja). Če spremeniš eno, spremeni obe.
indicator("Sweep Screener · Claude", shorttitle = "Sweep·C", overlay = true, scale = scale.right, max_bars_back = 5000, max_lines_count = 300, max_boxes_count = 200, max_labels_count = 200)

// ---------- nastavitve
tfIn   = input.timeframe("360", "Setup okvir", options = ["360", "D"], tooltip = "360 = 6H (graf 5m), D = 1D (graf 15m)")
showL  = input.bool(true, "Long", inline = "s", group = "Prikaz")
showS  = input.bool(true, "Short", inline = "s", group = "Prikaz")
extR   = input.int(15, "Podaljšaj desno (sveč)", minval = 1, maxval = 200, group = "Prikaz")
onlyLast = input.bool(true, "Samo zadnji setup (long ali short)", group = "Prikaz")
maxZ   = input.int(2, "Največ con iste vrste", minval = 1, maxval = 10, group = "Prikaz")
pFVG   = input.bool(true, "FVG", inline = "a", group = "Točke")
pIFVG  = input.bool(true, "IFVG", inline = "a", group = "Točke")
pVI    = input.bool(true, "VI", inline = "a", group = "Točke")
pCISD  = input.bool(true, "CISD", inline = "b", group = "Točke")
pGP    = input.bool(true, "GP", inline = "b", group = "Točke")
pOTE   = input.bool(true, "OTE", inline = "c", group = "Točke")
pSWP   = input.bool(true, "Posweepan nivo", inline = "c", group = "Točke")
pOPEN  = input.bool(true, "Open HTF", inline = "c", group = "Točke")
pFIB   = input.bool(true, "Fib pivoti", inline = "d", group = "Točke")
nFib   = input.int(6, "največ (samo dotaknjeni)", minval = 1, maxval = 6, inline = "d", group = "Točke")
s1d    = input.bool(true, "Pokaži današnje Sweep 1D limite", group = "Sweep 1D")

cFVG = #00d9ff, cIFVG = #b56bff, cVI = #9a9aa8, cGP = #ffd400, cOTE = #ff3df0
cLong = #2dff8f, cShort = #ff2d55, cSwp = #ff7a00, cMut = #8a8a96

// ---------- HTF sveče (zadnjih 8; setup uporablja pas zadnjih 4), sledene na grafu
var array<int>   hB = array.new<int>()
var array<int>   hT = array.new<int>()
var array<float> hO = array.new<float>()
var array<float> hH = array.new<float>()
var array<float> hL = array.new<float>()
var array<float> hC = array.new<float>()
if timeframe.change(tfIn) or hB.size() == 0
    hB.push(bar_index), hT.push(time), hO.push(open), hH.push(high), hL.push(low), hC.push(close)
    if hB.size() > 8
        hB.shift(), hT.shift(), hO.shift(), hH.shift(), hL.shift(), hC.shift()
else
    int nn = hB.size() - 1
    hH.set(nn, math.max(hH.get(nn), high)), hL.set(nn, math.min(hL.get(nn), low)), hC.set(nn, close)

atrS = ta.atr(14)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(open, 5000)
max_bars_back(close, 5000)
max_bars_back(atrS, 5000)

// zrcaljenje: sg = 1 long, -1 short (short = obrnjene cene, ista bull logika). Zgodovina cen samo v globalnem obsegu (ne v funkcijah).
HH(int q, int sg) => sg == 1 ? hH.get(q) : -hL.get(q)
HL(int q, int sg) => sg == 1 ? hL.get(q) : -hH.get(q)
HO(int q, int sg) => sg * hO.get(q)
HC(int q, int sg) => sg * hC.get(q)

var array<line>  LNS = array.new<line>()
var array<box>   BXS = array.new<box>()
var array<label> LBS = array.new<label>()

tag(int x, float y, string t, color c) =>
    LBS.push(label.new(x, y, t, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.small))
lvlLine(int x1, float y, string t, color c, string st, int w) =>
    LNS.push(line.new(x1, y, bar_index + extR, y, color = c, style = st, width = w))
    tag(bar_index + extR, y, t, c)
zone(int x1, float a, float b, string t, color c) =>
    BXS.push(box.new(x1, math.max(a, b), bar_index + extR, math.min(a, b), border_color = color.new(c, 40), bgcolor = color.new(c, 85), text = t, text_size = size.tiny, text_color = c, text_halign = text.align_right, text_valign = text.align_top))


// ---------- Sweep 1D: današnji limiti (včerajšnja sveča posweepa predvčerajšnjo in zapre nazaj)
[d1H, d1L, d1C, d1T] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
[d2H, d2L] = request.security(syminfo.tickerid, "D", [high[2], low[2]], lookahead = barmerge.lookahead_on)
a1h = request.security(syminfo.tickerid, "60", atrS[1], lookahead = barmerge.lookahead_on)
dStart = d1T + 86400000
var bool fillL = false
var bool fillS = false
var bool invL = false
var bool invS = false
if timeframe.change("D")
    fillL := false, fillS := false, invL := false, invS := false
if not fillL and not invL and low < d1L
    invL := true
if not fillL and not invL and low <= d2L
    fillL := true
if not fillS and not invS and high > d1H
    invS := true
if not fillS and not invS and high >= d2H
    fillS := true

s1dDraw(int sg) =>
    bool ok = sg == 1 ? d1L < d2L and d1C > d2L : d1H > d2H and d1C < d2H
    float lev0 = sg == 1 ? d2L : d2H
    float sl0 = (sg == 1 ? d1L : d1H) - sg * 0.1 * a1h
    float rp0 = math.abs(lev0 - sl0) / lev0
    float rr0 = ((d2H + d2L) / 2 - lev0) * sg / ((lev0 - sl0) * sg)
    bool inv0 = sg == 1 ? invL : invS
    if ok and rp0 >= 0.004 and rp0 <= 0.03 and rr0 >= 1 and not inv0
        float lev = sg == 1 ? d2L : d2H
        float ex = sg == 1 ? d1L : d1H
        float sl = ex - sg * 0.1 * a1h
        float tp = (d2H + d2L) / 2
        float rp = math.abs(lev - sl) / lev
        float rr = (tp - lev) * sg / ((lev - sl) * sg)
        bool fill = sg == 1 ? fillL : fillS
        bool inv = sg == 1 ? invL : invS
        string st = rp < 0.004 or rp > 0.03 ? "preskoči (SL)" : rr < 1 ? "preskoči (RR)" : inv ? "odpadel" : fill ? "vstop ✓" : "čaka"
        int x1 = dStart, x2 = dStart + 86400000
        color cT = sg == 1 ? cLong : cShort, cS = sg == 1 ? cShort : cLong
        BXS.push(box.new(x1, math.max(lev, tp), x2, math.min(lev, tp), xloc = xloc.bar_time, border_color = color.new(cT, 60), bgcolor = color.new(cT, 88)))
        BXS.push(box.new(x1, math.max(lev, sl), x2, math.min(lev, sl), xloc = xloc.bar_time, border_color = color.new(cS, 60), bgcolor = color.new(cS, 85)))
        LNS.push(line.new(x1, lev, x2, lev, xloc = xloc.bar_time, color = cSwp, width = 2))
        LBS.push(label.new(x1, sg == 1 ? math.min(lev, sl) : math.max(lev, sl), "Sweep 1D " + (sg == 1 ? "LONG" : "SHORT") + " limit " + str.tostring(lev, format.mintick) + " · SL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " · RR " + str.tostring(rr, "#.##") + " · " + st, xloc = xloc.bar_time, style = sg == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(cT, 80), textcolor = cT, size = size.small))

if barstate.islast
    for l in LNS
        l.delete()
    for b in BXS
        b.delete()
    for lb in LBS
        lb.delete()
    LNS.clear(), BXS.clear(), LBS.clear()
    array<int> rg0 = array.new<int>()   // za vsako narisano stran: l0, l1, b0, b1, lb0, lb1, extI
    for sgi = 0 to 1
        int sg = sgi == 0 ? 1 : -1
        if (sg == 1 and showL) or (sg == -1 and showS)
            int n = hB.size()
            int last = bar_index
            bool done = false
            if n >= 5
                // kot OnlyWicks (pas 4 HTF sveč): sweep sveča v zadnjih 3, najstarejši še živ setup ima prednost (wick čez ekstrem = Retest)
                for k = n - 3 to n - 1
                    if done
                        break
                    int sB = hB.get(k)
                    int sE = k + 1 < n ? hB.get(k + 1) - 1 : last
                    float Pl = HL(k - 1, sg)
                    int i0 = -1
                    int iS = math.max(sB, last - 4800)
                    for i = iS to math.max(iS, sE)
                        if (sg == 1 ? low[bar_index - (i)] : -high[bar_index - (i)]) < Pl
                            i0 := i
                            break
                    if i0 >= 0
                        float ext = na
                        int extI = -1
                        bool inval = false
                        float lvl = na
                        int lvlI = -1
                        bool cisd = false
                        int cisdI = -1
                        float hi = -1e100
                        array<float> fT = array.new<float>(), array<float> fBo = array.new<float>(), array<int> fI = array.new<int>(), array<bool> fD = array.new<bool>()
                        array<float> vT = array.new<float>(), array<float> vBo = array.new<float>(), array<int> vI = array.new<int>(), array<bool> vD = array.new<bool>()
                        for i = i0 to last
                            float bl = (sg == 1 ? low[bar_index - (i)] : -high[bar_index - (i)]), bh = (sg == 1 ? high[bar_index - (i)] : -low[bar_index - (i)]), bo = (sg * open[bar_index - (i)]), bc = (sg * close[bar_index - (i)])
                            if i <= sE
                                if na(ext) or bl < ext
                                    ext := bl, extI := i, lvl := na, lvlI := -1, cisd := false, cisdI := -1, hi := -1e100
                                    fT.clear(), fBo.clear(), fI.clear(), fD.clear(), vT.clear(), vBo.clear(), vI.clear(), vD.clear()
                                    // CISD: odprtje zadnje serije >= 2 dostavnih sveč, ki se konča na ekstremu ali pred njim
                                    int j = i
                                    int lim = math.max(0, i - 12)
                                    while j >= lim
                                        if (sg * close[bar_index - (j)]) < (sg * open[bar_index - (j)])
                                            int r0 = j
                                            while r0 - 1 >= lim and (sg * close[bar_index - (r0 - 1)]) < (sg * open[bar_index - (r0 - 1)])
                                                r0 -= 1
                                            if j - r0 + 1 >= 2
                                                lvl := (sg * open[bar_index - (r0)]), lvlI := r0
                                                break
                                            j := r0 - 1
                                        else
                                            j -= 1
                            else if bc <= ext
                                // setup mrtev šele, ko sveča ZAPRE čez ekstrem
                                inval := true
                                break
                            if i > extI
                                if not na(lvl) and not cisd and bc > lvl
                                    cisd := true, cisdI := i
                                if i - 2 >= extI and bl > (sg == 1 ? high[bar_index - (i - 2)] : -low[bar_index - (i - 2)]) and bl - (sg == 1 ? high[bar_index - (i - 2)] : -low[bar_index - (i - 2)]) >= 0.3 * atrS[bar_index - (i)]
                                    fT.push(bl), fBo.push((sg == 1 ? high[bar_index - (i - 2)] : -low[bar_index - (i - 2)])), fI.push(i), fD.push(false)
                                float pc = (sg * close[bar_index - (i - 1)]), po = (sg * open[bar_index - (i - 1)])
                                if i - 1 > extI and bc > bo and pc > po and bo > pc and bl <= (sg == 1 ? high[bar_index - (i - 1)] : -low[bar_index - (i - 1)])
                                    vT.push(bo), vBo.push(pc), vI.push(i), vD.push(false)
                                if fT.size() > 0
                                    for q = 0 to fT.size() - 1
                                        if i > fI.get(q) and bc < fBo.get(q)
                                            fD.set(q, true)
                                if vT.size() > 0
                                    for q = 0 to vT.size() - 1
                                        if i > vI.get(q) and bc < vBo.get(q)
                                            vD.set(q, true)
                                hi := math.max(hi, bh)
                        // nivo: najbolj skrajen še deviški nivo v pasu (do 3 sveče nazaj), ki ga je sweep vzel
                        int rfK = k - 1
                        int qLo = math.max(0, n - 4, k - 3)
                        if k - 2 >= qLo
                            for q = k - 2 to qLo
                                float vq = HL(q, sg)
                                bool vir = true
                                for m = q + 1 to k - 1
                                    if HL(m, sg) < vq
                                        vir := false
                                if vir and vq > ext and vq < HL(rfK, sg)
                                    rfK := q
                        float rfL = HL(rfK, sg)
                        // setup šele, ko sweep sveča zapre nazaj nad nivo (odprta sveča: trenutna cena)
                        float sC = k < n - 1 ? HC(k, sg) : sg * close
                        if not inval and extI >= 0 and sC > rfL
                            done := true
                            int l0 = LNS.size(), b0 = BXS.size(), lb0 = LBS.size()
                            float piv = (HH(rfK, sg) + HL(rfK, sg) + HC(rfK, sg)) / 3
                            float rg = HH(rfK, sg) - HL(rfK, sg)
                            int legStart = math.max(hB.get(rfK), last - 4800)
                            color cSide = sg == 1 ? cLong : cShort
                            color cSL = sg == 1 ? cShort : cLong
                            float px = sg * close
                            // najnižji low / najvišji high od vsake sveče naprej
                            array<float> mnF = array.new<float>(last - legStart + 2, 1e100)
                            array<float> mxF = array.new<float>(last - legStart + 2, -1e100)
                            for i = last to legStart
                                mnF.set(i - legStart, math.min(mnF.get(i - legStart + 1), (sg == 1 ? low[bar_index - (i)] : -high[bar_index - (i)])))
                                mxF.set(i - legStart, math.max(mxF.get(i - legStart + 1), (sg == 1 ? high[bar_index - (i)] : -low[bar_index - (i)])))
                            // FVG: prvi še nepokrit FVG po ekstremu (kot indikator)
                            if pFVG and fT.size() > 0
                                for q = 0 to fT.size() - 1
                                    if not fD.get(q)
                                        zone(fI.get(q) - 2, sg * fT.get(q), sg * fBo.get(q), "FVG", cFVG)
                                        break
                            // IFVG: FVG v potezi v sweep, ki ga je close prvi prebil PO ekstremu; prebit nazaj = "IFVG ✗"
                            if pIFVG
                                int bInv = 1000000000
                                float bTop = na
                                float bBot = na
                                int bZ = -1
                                bool bDead = false
                                int zA = math.max(legStart + 2, 2)
                                int zB = math.min(extI + 1, last)
                                if zB >= zA
                                    for z = zA to zB
                                        float top = (sg == 1 ? low[bar_index - (z - 2)] : -high[bar_index - (z - 2)]), bot = (sg == 1 ? high[bar_index - (z)] : -low[bar_index - (z)])
                                        if top > bot and top - bot >= 0.3 * atrS[bar_index - (z)]
                                            int inv = -1
                                            bool dead = false
                                            for y = z + 1 to last
                                                float cy = sg * close[bar_index - (y)]
                                                if inv < 0
                                                    if cy > top
                                                        inv := y
                                                        if inv <= extI or inv >= bInv
                                                            break
                                                else if cy < bot
                                                    dead := true
                                                    break
                                            if inv > extI and inv < bInv
                                                bInv := inv, bTop := top, bBot := bot, bZ := z, bDead := dead
                                if bZ >= 0
                                    zone(bZ - 2, sg * bTop, sg * bBot, bDead ? "IFVG ✗" : "IFVG", bDead ? cMut : cIFVG)
                            // VI
                            if pVI and vT.size() > 0
                                int cnt = 0
                                for q = vT.size() - 1 to 0
                                    if cnt < maxZ and not vD.get(q) and (vI.get(q) >= last or mnF.get(vI.get(q) + 1 - legStart) > vBo.get(q))
                                        zone(vI.get(q), sg * vT.get(q), sg * vBo.get(q), "VI", cVI)
                                        cnt += 1
                            // CISD
                            if pCISD and not na(lvl)
                                lvlLine(lvlI, sg * lvl, cisd ? "CISD" : "CISD ?", cFVG, line.style_dashed, 1)
                            // OTE (kot indikator, 1-2 trigger FVG + "impulse must clear"): 0,618–0,786 povratka od ekstrema do najdlje po njem; šele ko impulz s FVG preseže celo sweep svečo
                            float r2 = hi - ext
                            if pOTE and r2 > 0 and fT.size() > 0 and hi > HH(k, sg)
                                float oT = hi - 0.618 * r2, oB = hi - 0.786 * r2
                                bool hit = false
                                for z = extI + 1 to last
                                    if (sg == 1 ? high[bar_index - (z)] : -low[bar_index - (z)]) >= hi
                                        hit := z < last and mnF.get(z + 1 - legStart) <= oT
                                        break
                                zone(extI, sg * oT, sg * oB, hit ? "OTE ✓" : "OTE", cOTE)
                            // fib pivoti sveče nivoja: samo dotaknjeni (od začetka sweep sveče)
                            if pFIB
                                array<float> fl = array.from(0.5, 0.618, 0.786, 1.0, 1.618, 2.618)
                                int s0 = math.max(sB, legStart)
                                int nf = 0
                                for f in fl
                                    float L = piv - f * rg
                                    if nf < nFib and L > ext - 1.5 * rg and mnF.get(s0 - legStart) <= L and mxF.get(s0 - legStart) >= L
                                        lvlLine(hB.get(rfK), sg * L, "Fib " + str.tostring(f), cMut, line.style_dotted, 1)
                                        nf += 1
                            // GP prejšnje HTF sveče: izgine, ko jo cena preide v celoti (od sweep sveče naprej)
                            if pGP
                                float PH = HH(k - 1, sg), PL = HL(k - 1, sg)
                                bool bear = HC(k - 1, sg) < HO(k - 1, sg)
                                float gA = bear ? PH - 0.618 * (PH - PL) : PL + 0.618 * (PH - PL)
                                float gB = bear ? PH - 0.65 * (PH - PL) : PL + 0.65 * (PH - PL)
                                int g0 = math.max(sB, legStart)
                                if not (mnF.get(g0 - legStart) <= math.min(gA, gB) and mxF.get(g0 - legStart) >= math.max(gA, gB))
                                    zone(hB.get(k - 1), sg * gA, sg * gB, "GP", cGP)
                            // posweepan nivo, ekstrem, open HTF
                            if pSWP
                                lvlLine(hB.get(rfK), sg * rfL, "Sweep", cSwp, line.style_solid, 2)
                            lvlLine(extI, sg * ext, "SL", cSL, line.style_solid, 2)
                            LBS.push(label.new(extI, sg * ext, sg == 1 ? "▲" : "▼", style = sg == 1 ? label.style_label_up : label.style_label_down, color = color.new(cSide, 100), textcolor = cSwp, size = size.normal))
                            if pOPEN
                                lvlLine(hB.get(n - 1), hO.get(n - 1), "Open HTF", cMut, line.style_dotted, 1)
                            // začetek sweep sveče
                            LNS.push(line.new(sB, sg * ext, sB, sg * HH(k, sg), color = color.new(cMut, 50), style = line.style_dotted))
                            LBS.push(label.new(sB, sg * HH(k, sg), (sg == 1 ? "LONG" : "SHORT") + " setup " + (tfIn == "D" ? "1D" : "6H") + (cisd ? " · CISD ✓" : ""), style = label.style_label_lower_left, color = color.new(cSide, 80), textcolor = cSide, size = size.small))
                            rg0.push(l0), rg0.push(LNS.size()), rg0.push(b0), rg0.push(BXS.size()), rg0.push(lb0), rg0.push(LBS.size()), rg0.push(sB * 10000 + math.min(9999, extI - sB))
    // samo zadnji setup: pobriši risbe starejše strani (starejša sweep sveča; ista sveča → zgodnejši ekstrem)
    if onlyLast and rg0.size() == 14
        int o = rg0.get(6) < rg0.get(13) ? 0 : 7
        for q = rg0.get(o) to rg0.get(o + 1) - 1
            if q >= rg0.get(o) and q < rg0.get(o + 1)
                LNS.get(q).delete()
        for q = rg0.get(o + 2) to rg0.get(o + 3) - 1
            if q >= rg0.get(o + 2) and q < rg0.get(o + 3)
                BXS.get(q).delete()
        for q = rg0.get(o + 4) to rg0.get(o + 5) - 1
            if q >= rg0.get(o + 4) and q < rg0.get(o + 5)
                LBS.get(q).delete()

    if s1d and timeframe.in_seconds() < 86400
        s1dDraw(1)
        s1dDraw(-1)
